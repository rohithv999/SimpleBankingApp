              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 200\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Balance is 300', () => pm.expect(pm.response.json().balance).to.eql(300));",
                  "pm.test('Withdrawal transaction created', () => pm.expect(pm.response.json().transactions.at(-1).type).to.eql('WITHDRAW'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Withdraw - Insufficient Balance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
