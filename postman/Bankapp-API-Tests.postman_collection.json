            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"accountType\": \"CHECKING\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "pm.test('New account starts at zero', () => pm.expect(pm.response.json().balance).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Account By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
