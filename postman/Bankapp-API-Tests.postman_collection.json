            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Account type updated', () => pm.expect(pm.response.json().accountType).to.eql('SAVINGS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Deposit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{accountId}}",
                "deposit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Balance is 500', () => pm.expect(pm.response.json().balance).to.eql(500));",
                  "pm.test('Deposit transaction created', () => pm.expect(pm.response.json().transactions.at(-1).type).to.eql('DEPOSIT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Withdraw",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
